# Server
PORT=4000
NODE_ENV=development

# CORS - comma separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourapp.com

# JWT
JWT_ACCESS_SECRET=change-this-to-a-long-random-secret
# Optional: only needed if the gateway itself ever issues/refreshes tokens
JWT_REFRESH_SECRET=change-this-too-a-different-long-random-secret

# Downstream services (private network URLs in production)
USER_SERVICE_URL=http://localhost:4001
NOTIFICATION_SERVICE_URL=http://localhost:4002
MONOLITH_SERVICE_URL=http://localhost:4003

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Body size limit
JSON_BODY_LIMIT=100kb
